{
  "name": "lesson-plan-service",
  "version": "1.0.0",
  "description": "Qshikshak Lesson Plan Microservice",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --require ts-node/register/transpile-only --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:unit": "node --require ts-node/register/transpile-only --test --test-reporter=spec \"tests/unit/*.test.ts\" \"tests/api/security.test.ts\"",
    "seed": "ts-node scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
