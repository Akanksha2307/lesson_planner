# Copy to .env (local) or .env.docker (docker compose). Never commit real values.
PORT=5002
NODE_ENV=development
MONGO_URL=
# Must be the same secret the Auth service signs its login tokens with
JWT_SECRET=same-long-random-string-for-everyone
# Shared with the Auth and Approval services for /internal/... calls
INTERNAL_TOKEN=another-long-random-string-for-everyone
DEFAULT_SCHOOL_ID=one
# approval-service sends the bell notifications (holiday added, lessons moved …)
APPROVAL_URL=http://localhost:5003
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3002
# Development only: lets you call the API with x-user-id / x-user-role headers
ALLOW_DEV_AUTH=false
