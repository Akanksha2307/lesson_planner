# Copy to .env (never commit .env). Real values are shared privately.
NODE_ENV=development
PORT=5001

# Atlas address WITHOUT a database name – the service adds DB_NAME
MONGO_BASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=qshikshak_auth

# Access token: the SAME value in every service (they all check it). At least 16 characters.
JWT_ACCESS_SECRET=same-long-random-string-for-every-service
# Refresh token: auth-service ONLY. Must be different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=another-long-random-string-only-for-auth
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=qshikshak-auth
JWT_AUDIENCE=qshikshak

# Other services send this as x-internal-token. The SAME value in every service.
INTERNAL_TOKEN=another-long-random-string-for-every-service

# Comma-separated list of websites allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3002
BODY_LIMIT=1mb
LOGIN_RATE_LIMIT=20

DEFAULT_SCHOOL_ID=one

# x-user-id / x-user-role test headers and demo login. Never true in production.
ALLOW_DEV_AUTH=true