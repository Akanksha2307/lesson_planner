# Copy to .env (local) or .env.docker (docker compose). Never commit real values.
NODE_ENV=development
PORT=5003

# Full MongoDB address INCLUDING the database name
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/qshikshak_approvals?retryWrites=true&w=majority

# The SAME value as JWT_ACCESS_SECRET in auth-service (approval-service only checks tokens)
JWT_ACCESS_SECRET=same-long-random-string-for-everyone
JWT_ISSUER=qshikshak-auth
JWT_AUDIENCE=qshikshak

# The SAME value in every service (x-internal-token)
INTERNAL_TOKEN=another-long-random-string-for-everyone

CORS_ORIGINS=http://localhost:3002

# lesson-plan-service: the plans AND the school data
LESSON_PLAN_URL=http://localhost:5002
