{
  "name": "approval-service",
  "version": "2.0.0",
  "private": true,
  "description": "Qshikshak Approval Service (TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\" \"tests/api/security.test.ts\"",
    "test:api": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"tests/api/review.test.ts\" \"tests/api/notifications.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
